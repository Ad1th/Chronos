// chronos/db/schema.prisma
// Prisma schema for the Chronos event store

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id             String   @id @default(uuid())
  type           String
  service        String
  timestamp      DateTime @default(now())
  payload        Json
  requestId      String
  correlationId  String

  @@index([timestamp])
  @@index([correlationId])
  @@map("events")
}
