{
  "name": "chronos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only api/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/index.js",
    "prisma:generate": "prisma generate --schema db/schema.prisma",
    "prisma:migrate": "prisma migrate dev --name init --schema db/schema.prisma",
    "test:auth": "ts-node scripts/testAuthService.ts",
    "test:replay": "ts-node scripts/testReplay.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
